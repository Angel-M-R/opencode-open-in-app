{
  "name": "opencode-open-in-app",
  "version": "0.0.0-development",
  "description": "OpenCode TUI plugin for opening the current project in a desktop app",
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "prepare": "husky",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.50 <2",
    "@opentui/core": ">=0.4.0 <0.5",
    "@opentui/solid": ">=0.4.0 <0.5",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "22.19.19",
    "esbuild-plugin-solid": "0.6.0",
    "husky": "^9.1.7",
    "solid-js": "1.9.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
