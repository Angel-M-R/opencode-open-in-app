{
  "name": "opencode-open-in-app",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin for opening the current project in a desktop app",
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "vscode",
    "cursor"
  ],
  "homepage": "https://github.com/Angel-M-R/opencode-open-in-app#readme",
  "bugs": {
    "url": "https://github.com/Angel-M-R/opencode-open-in-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-M-R/opencode-open-in-app.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run test:unit && pnpm run test:tui",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "pack:dry-run": "npm pack --dry-run --json",
    "pack:check": "node scripts/assert-package-contents.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "release": "semantic-release",
    "prepare": "husky",
    "prepack": "pnpm run build",
    "test:tui": "bun test --preload @opentui/solid/preload test/native"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12 <0.6",
    "@opentui/solid": ">=0.5.12 <0.6",
    "solid-js": ">=1.9.12 <2",
    "@opencode/plugin": ">=2.0.18 <3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "22.19.19",
    "esbuild-plugin-solid": "0.6.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "solid-js": "1.9.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7",
    "@opencode/plugin": "2.0.18",
    "@types/bun": "^1.3.0"
  }
}
